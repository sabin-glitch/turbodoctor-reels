-desc-page","hidden":""}},"mime":"application/pdf"}]},"91856290":{"pageid":91856290,"ns":6,"title":"File:The annals and magazine of natural history - zoology, botany, and geology (IA ser7annalsmagazi14londuoft).pdf","index":14,"imagerepository":"local","imageinfo":[{"size":29133737,"width":797,"height":1243,"pagecount":520,"url":"https://upload.wikimedia.org/wikipedia/commons/b/b8/The_annals_and_magazine_of_natural_history_-_zoology%2C_botany%2C_and_geology_%28IA_ser7annalsmagazi14londuoft%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:The_annals_and_magazine_of_natural_history_-_zoology,_botany,_and_geology_(IA_ser7annalsmagazi14londuoft).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=91856290","extmetadata":{"ImageDescription":{"value":"<div class=\"description\">\n<dl><dd>Formed by the Union of the Magazine of zoology and botany, and Companion to the botanical magazine</dd>\n<dd>Title varies: Mar. 1838-Aug. 1840, Annals of natural history; or, Magazine of zoology, botany and geology</dd>\n<dd>Superseded by Journal of natural history</dd>\n<dd>14</dd></dl>\n<br>Subjects: Natural history</div>","source":"commons-desc-page"},"Credit":{"value":"<dl><dd><a href=\"//archive.org/details/ser7annalsmagazi14londuoft\" class=\"extiw\" title=\"iarchive:ser7annalsmagazi14londuoft\"><bdi class=\"description en\" lang=\"en\" dir=\"ltr\">Internet Archive identifier:</bdi> ser7annalsmagazi14londuoft</a></dd>\n<dd><a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/download/ser7annalsmagazi14londuoft/ser7annalsmagazi14londuoft.pdf\">https://archive.org/download/ser7annalsmagazi14londuoft/ser7annalsmagazi14londuoft.pdf</a></dd></dl>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""}},"mime":"appl