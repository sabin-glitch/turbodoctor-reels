843":{"pageid":91510843,"ns":6,"title":"File:NGS 4, Hall, November 1963 (IA ngs4hallnovembe00nati).pdf","index":2,"imagerepository":"local","imageinfo":[{"size":16699931,"width":2706,"height":3464,"pagecount":94,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/NGS_4%2C_Hall%2C_November_1963_%28IA_ngs4hallnovembe00nati%29.pdf/page1-1920px-NGS_4%2C_Hall%2C_November_1963_%28IA_ngs4hallnovembe00nati%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2048,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/NGS_4%2C_Hall%2C_November_1963_%28IA_ngs4hallnovembe00nati%29.pdf/page1-1920px-NGS_4%2C_Hall%2C_November_1963_%28IA_ngs4hallnovembe00nati%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2048},"url":"https://upload.wikimedia.org/wikipedia/commons/c/cb/NGS_4%2C_Hall%2C_November_1963_%28IA_ngs4hallnovembe00nati%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:NGS_4,_Hall,_November_1963_(IA_ngs4hallnovembe00nati).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=91510843","extmetadata":{"Artist":{"value":"<div class=\"fn value\">\nNational Museum of Natural History (U.S.) Pacific Ocean Biological Survey Program</div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n<p>This item consists of a folder of data collected at sea by Pacific Ocean Biological Survey Program staff, 1963, on Northern Grid Survey 4. The Northern Grid Survey was conducted of a square section of the Pacific Ocean near Hawaii. Materials include bird observations, position data, and weather data. Bird observations include: time, species, number, dir., hgt., and remarks. Weather data includes recordings of wind speed, temp. Locality data records miles from Oahu, and other locations. Additional data sheets recorded time, lat., long., pres wea, vis, slp, dry b, wet b, dew pt, hum%, sky, opa sky, waves, sea temp, wind s, wind d, course, speed. Some graphs of weather data are included\n</p>\n<br>Subjects: Pacific Ocean Biological Survey Program; Ornithology</div>","source":"commons-desc-page"},"Credit":{"value":"<dl><dd><a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/details/ngs4hallnovembe00nati\">https://archive.org/details/ngs4hallnovembe00nati</a></dd>\n<dd><a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/download/ngs4hallnovembe00nati/ngs4hallnovembe00nati_bw.pdf\">https://archive.org/download/ngs4hallnovembe00nati/ngs4hallnovembe00nati_bw.pdf</a></dd></dl>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""}},"mime":"application/pdf"}]}}}}