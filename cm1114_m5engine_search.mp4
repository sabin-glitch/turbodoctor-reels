{"batchcomplete":"","query":{"pages":{"112906218":{"pageid":112906218,"ns":6,"title":"File:BMW 535i F10 (5227267038).jpg","index":24,"imagerepository":"local","imageinfo":[{"size":5713351,"width":3294,"height":2196,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/BMW_535i_F10_%285227267038%29.jpg/1920px-BMW_535i_F10_%285227267038%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1067,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/f/fc/BMW_535i_F10_%285227267038%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/BMW_535i_F10_%285227267038%29.jpg/1920px-BMW_535i_F10_%285227267038%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1067,"srcset":"https://upload.wikimedia.org/wikipedia/commons/f/fc/BMW_535i_F10_%285227267038%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/fc/BMW_535i_F10_%285227267038%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:BMW_535i_F10_(5227267038).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=112906218","extmetadata":{"ImageDescription":{"value":"Improvements over the E60-generation 5-series include a front dual ball joint short-long arm suspension, and rear multilink suspension. The F10 has, for the European market at least, a choice of 7 engines: the N63 4.4 litre V8 topping the range in the 550i, followed by a trio of straight-6 petrols. Despite many rumours[7] to the contrary, BMW's second best selling model after the 3 series does not use any 4 cylinder petrol engines this time round. Instead, BMW has retained, for the time being at least, a trio of straight 6 engines, completing the petrol engine range. Straight six engines offer superior refinement over their 4 cylinder counterparts, as well as being the trademark BMW engine which has featured in many of the company's most successful cars: the E28 and E34 M5, E36 and E46 M3, plus the iconic BMW E26 M1. The 535i has the 306 hp (228 kW)/295 lb ft(400 N m) BMW N55 engine which made its debut in the F07 5-series GT, and will shortly find its way into the facelifted BMW E92 and E93.[8] The magnesium block naturally aspirated direct injection straight 6 continues; this engine is the BMW N53; 3.0 litres, 258 bhp for the 528i, and 3.0 litres and 204 bhp for the 523i, same outputs as the BMW E89 Z4 sDrive23i.","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/christiandflores/5227267038/\">BMW 535i F10</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/10290887@N03\">Christian Flores</a> from Carlsbad / Encinitas, United States of America","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"112906221":{"pageid":112906221,"ns":6,"title":"File:BMW 550i F10 (5226669841).jpg","index":25,"imagerepository":"local","imageinfo":[{"size":5630254,"width":3294,"height":2196,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/BMW_550i_F10_%285226669841%29.jpg/1920px-BMW_550i_F10_%285226669841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1067,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/1/19/BMW_550i_F10_%285226669841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/BMW_550i_F10_%285226669841%29.jpg/1920px-BMW_550i_F10_%285226669841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1067,"srcset":"https://upload.wikimedia.org/wikipedia/commons/1/19/BMW_550i_F10_%285226669841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/19/BMW_550i_F10_%285226669841%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:BMW_550i_F10_(5226669841).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=112906221","extmetadata":{"ImageDescription":{"value":"Improvements over the E60-generation 5-series include a front dual ball joint short-long arm suspension, and rear multilink suspension. The F10 has, for the European market at least, a choice of 7 engines: the N63 4.4 litre V8 topping the range in the 550i, followed by a trio of straight-6 petrols. Despite many rumours[7] to the contrary, BMW's second best selling model after the 3 series does not use any 4 cylinder petrol engines this time round. Instead, BMW has retained, for the time being at least, a trio of straight 6 engines, completing the petrol engine range. Straight six engines offer superior refinement over their 4 cylinder counterparts, as well as being the trademark BMW engine which has featured in many of the company's most successful cars: the E28 and E34 M5, E36 and E46 M3, plus the iconic BMW E26 M1. The 535i has the 306 hp (228 kW)/295 lb ft(400 N m) BMW N55 engine which made its debut in the F07 5-series GT, and will shortly find its way into the facelifted BMW E92 and E93.[8] The magnesium block naturally aspirated direct injection straight 6 continues; this engine is the BMW N53; 3.0 litres, 258 bhp for the 528i, and 3.0 litres and 204 bhp for the 523i, same outputs as the BMW E89 Z4 sDrive23i.","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/christiandflores/5226669841/\">BMW 550i F10</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/10290887@N03\">Christian Flores</a> from Carlsbad / Encinitas, United States of America","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"6051083":{"pageid":6051083,"ns":6,"title":"File:BMW Dinan E39 M5 S62 engine in 2008 team SigalSport Daytona Prototype.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":169793,"width":1000,"height":750,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/c/c4/BMW_Dinan_E39_M5_S62_engine_in_2008_team_SigalSport_Daytona_Prototype.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1200,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/c/c4/BMW_Dinan_E39_M5_S62_engine_in_2008_team_SigalSport_Daytona_Prototype.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1200},"url":"https://upload.wikimedia.org/wikipedia/commons/c/c4/BMW_Dinan_E39_M5_S62_engine_in_2008_team_SigalSport_Daytona_Prototype.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:BMW_Dinan_E39_M5_S62_engine_in_2008_team_SigalSport_Daytona_Prototype.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=6051083","extmetadata":{"ImageDescription":{"value"