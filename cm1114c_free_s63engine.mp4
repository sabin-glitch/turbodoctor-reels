ternal free\" href=\"https://archive.org/download/cu31924003633603/cu31924003633603.pdf\">https://archive.org/download/cu31924003633603/cu31924003633603.pdf</a></dd></dl>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""}},"mime":"application/pdf"}]},"6709507":{"pageid":6709507,"ns":6,"title":"File:Mercury-Redstone 1 launch attempt S63-02651.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":1172478,"width":2401,"height":3000,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Mercury-Redstone_1_launch_attempt_S63-02651.jpg/1920px-Mercury-Redstone_1_launch_attempt_S63-02651.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1999,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/6/63/Mercury-Redstone_1_launch_attempt_S63-02651.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Mercury-Redstone_1_launch_attempt_S63-02651.jpg/1920px-Mercury-Redstone_1_launch_attempt_S63-02651.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1999,"srcset":"https://upload.wikimedia.org/wikipedia/commons/6/63/Mercury-Redstone_1_launch_attempt_S63-02651.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/6/63/Mercury-Redstone_1_launch_attempt_S63-02651.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Mercury-Redstone_1_launch_attempt_S63-02651.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=6709507","extmetadata":{"ImageDescription":{"value":"Flight Mercury-Redstone 1 (MR-1) about to launch from Cape Canaveral on November 21, 1960. Notice the smoke begining to appear at the bottom of the rocket. This launch failed when the engine shut down immediately after liftoff, due to an electrical fault, causing the rocket to settle back on the launch stand. The rocket stayed upright and did not explode, but the escape tower jettisoned itself, and the capsule released its recovery parachutes while remaining attached to the booster.","source":"commons-desc-page"},"Credit":{"value":"<p>Johnson Space Center's Digital Image Collection, <a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://images.jsc.nasa.gov/luceneweb/caption_direct.jsp?photoId=S63-02651\" href=\"https://images.jsc.nasa.gov/luceneweb/caption_direct.jsp?photoId=S63-02651\">http://images.jsc.nasa.gov/luceneweb/caption_direct.jsp?photoId=S63-02651</a>.\n</p>\n(This photo is misidentified in the NASA photo archive as showing the launch of Mercury-Redstone 4, but the booster's markings are clearly those of MR-1, and the cloud pattern exactly matches that in the MR-1 photo of <a href=\"//commons.wikimedia.org/wiki/File:10073418.jpg\" class=\"mw-redirect\" title=\"File:10073418.jpg\">the escape rocket launch</a>.)","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"91791669":{"pageid":91791669,"ns":6,"title":"File:National centennial celebration and exposition (IA nationalcentenni00kell).pdf","index":13,"imagerepository":"local","imageinfo":[{"size":930977,"width":852,"height":1383,"pagecount":12,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/National_centennial_celebration_and_exposition_%28IA_nationalcentenni00kell%29.pdf/page1-500px-National_centennial_celebrati