}},"mime":"application/pdf"}]},"459876":{"pageid":459876,"ns":6,"title":"File:Escape rocket of Mercury-Redstone 1.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":2365782,"width":3642,"height":4688,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Escape_rocket_of_Mercury-Redstone_1.jpg/1920px-Escape_rocket_of_Mercury-Redstone_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2060,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/e/e0/Escape_rocket_of_Mercury-Redstone_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Escape_rocket_of_Mercury-Redstone_1.jpg/1920px-Escape_rocket_of_Mercury-Redstone_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2060,"srcset":"https://upload.wikimedia.org/wikipedia/commons/e/e0/Escape_rocket_of_Mercury-Redstone_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e0/Escape_rocket_of_Mercury-Redstone_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Escape_rocket_of_Mercury-Redstone_1.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=459876","extmetadata":{"ImageDescription":{"value":"Failed launch of the Mercury-Redstone 1 launch vehicle. While the booster umbilical is still falling toward the ground, an electrical fault causes the booster's engine to shut down and triggers the Mercury capsule's escape rocket to jettison itself. The booster rises only 4 inches before settling back onto the pad, and the capsule remains attached to the booster. \n(Note this photo is misdated and misidentified in NASA's photo archives.)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://spaceflight.nasa.gov/gallery/images/mercury/mercury_ov/html/s63-00193.html\" href=\"https://spaceflight.nasa.gov/gallery/images/mercury/mercury_ov/html/s63-00193.html\">http://spaceflight.nasa.gov/gallery/images/mercury/mercury_ov/html/s63-00193.html</a>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"92185615":{"pageid":92185615,"ns":6,"title":"File:FEDLINK - United States Federal Collection (IA CAT30973701).pdf","index":42,"imagerepository":"local","imageinfo":[{"size":23677789,"width":1281,"height":1610,"pagecount":368,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/FEDLINK_-_United_States_Federal_Collection_%28IA_CAT30973701%29.pdf/page1-1280px-FEDLINK_-_United_States_Federal_Collection_%28IA_CAT30973701%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2011,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/FEDLINK_-_United_States_Federal_Collection_%28IA_CAT30973701%29.pdf/page1-1280px-FEDLINK_-_United_States_Federal_Collection_%28IA_CAT30973701%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2011},"url":"https://upload.wikimedia.org/wikipedia/commons/b/bc/FEDLINK_-_United_States_Federal_Collection_%28IA_CAT30973701%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:FEDLINK_-_United_States_Federal_Collection_(IA_CAT30973701).pdf","descriptionshorturl":"https://commons.wikim