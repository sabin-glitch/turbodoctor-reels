{"batchcomplete":"","continue":{"gsroffset":50,"continue":"gsroffset||"},"query":{"pages":{"51028551":{"pageid":51028551,"ns":6,"title":"File:090630 KR Otto Fricke.ogg","index":37,"imagerepository":"local","imageinfo":[{"size":66568604,"width":0,"height":0,"duration":5577.064421768708,"url":"https://upload.wikimedia.org/wikipedia/commons/7/71/090630_KR_Otto_Fricke.ogg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:090630_KR_Otto_Fricke.ogg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=51028551","extmetadata":{"ImageDescription":{"value":"KR218 Otto Fricke\n<p>Dienstag, 30. Juni 2009 00:50\n</p>\nOtto Fricke, FDP, Vorsitzender des Bundestags-Haushaltsausschusses, \u00fcber seine Arbeit im Parlament, Web-Aktivit\u00e4ten von Politikern und seine Eitelkeit. Im Chat waren die Reaktionen sehr kontrovers. Entscheidet selbst, k\u00f6nnt auch \u2026","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"http://www.kuechenstud.io/kuechenradio/\">http://www.kuechenstud.io/kuechenradio/</a>","source":"commons-desc-page"},"Artist":{"value":"K\u00fcchenradio","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 3.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"application/ogg"}]},"109601431":{"pageid":109601431,"ns":6,"title":"File:Amiga 2000 loading Lotus Turbo Challenge 2 from floppy disk.flac","index":32,"imagerepository":"local","imageinfo":[{"size":4731161,"width":0,"height":0,"duration":93.60861678004535,"url":"https://upload.wikimedia.org/wikipedia/commons/0/05/Amiga_2000_loading_Lotus_Turbo_Challenge_2_from_floppy_disk.flac?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Amiga_2000_loading_Lotus_Turbo_Challenge_2_from_floppy_disk.flac","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=109601431","extmetadata":{"ImageDescription":{"value":"An Amiga 2000 loading the game <i><a href=\"https://en.wikipedia.org/wiki/Lotus_Turbo_Challenge_2\" class=\"extiw\" title=\"w:Lotus Turbo Challenge 2\">Lotus Turbo Challenge 2</a></i> from floppy disk. Game audio has been muted.\n<p>This game uses a non-AmigaDOS disk format which causes loading sounds to be quite different from a standard AmigaDOS disk such as Workbench. The metal case of the Amiga 2000 is also very large and resonant and (at least in this case) mostly empty, making the disk sounds even louder. The whooshing noise is from the Amiga's case fan.\n</p>\nRecorded with a Blue Yeti microphone.","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Morn\" title=\"User:Morn\">Morn</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"audio/x-flac"}]},"109564081":{"pageid":109564081,"ns":6,"title":"File:CPC6128 loading Turbo Esprit from floppy disk.flac","index":29,"imagerepository":"local","imageinfo":[{"size":1552175,"width":0,"height":0,"duration":25.602834467120182,"url":"https://upload.wikimedia.org/wikipedia/commons/6/6c/CPC6128_loading_Turbo_Esprit_from_floppy_disk.flac?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:CPC6128_loading_Turbo_Esprit_from_floppy_disk.flac","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=109564081","extmetadata":{"ImageDescription":{"value":"A Schneider CPC6128 loading the game <i><a href=\"https://en.wikipedia.org/wiki/Turbo_Esprit\" class=\"extiw\" title=\"w:Turbo Esprit\">Turbo Esprit</a></i> (from the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.cpc-power.com/index.php?page=detail&amp;num=3835\">Durell Big Four compilation</a>) from floppy disk. The background hum is from the CPC's CRT. Recorded with a Blue Yeti microphone.","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Morn\" title=\"User:Morn\">Morn</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"audio/x-flac"}]},"58115777":{"pageid":58115777,"ns":6,"title":"File:De-BMW Turbo X1-article.ogg","index":2,"imagerepository":"local","imageinfo":[{"size":2184111,"width":0,"height":0,"duration":292.261768707483,"url":"https://upload.wikimedia.org/wikipedia/commons/5/54/De-BMW_Turbo_X1-article.ogg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:De-BMW_Turbo_X1-article.ogg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=58115777","extmetadata":{"ImageDescription":{"value":"<div class=\"haudio\"><div class=\"hproduct commons-file-information-table\">\n<table class=\"fileinfotpl-type-information vevent\" dir=\"ltr\">\n\n<tbody><tr>\n<td id=\"fileinfotpl_desc\" class=\"fileinfo-paramfield\" lang=\"en\">Description<span class=\"summary fn\" style=\"display:none\">De-BMW Turbo X1-article.ogg</span></td>\n<td class=\"description\">\n<p>This is  a spoken word version of the Wikipedia article: <b><span class=\"plainlinks\"><a class=\"external text\" href=\"https://de.wikipedia.org/wiki/BMW_Turbo_X1?oldid=164522624\">BMW Turbo X1</a></span></b><br><span class=\"audiolink\"><a href=\"https://upload.wikimedia.org/wikipedia/commons/5/54/De-BMW_Turbo_X1-article.ogg?utm_source=commo