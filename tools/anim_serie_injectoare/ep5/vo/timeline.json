 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 2.97,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.27,
   "end": 7.805,
   "text": "Astăzi prezentăm cauza 5 din 13: șaiba de etanșare."
  },
  {
   "i": 2,
   "start": 8.155,
   "end": 11.935,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 12.535,
   "end": 17.985,
   "text": "Între injector și chiulasă stă o șaibă de cupru, care ține gazele de ardere în cilindru."
  },
  {
   "i": 4,
   "start": 18.435,
   "end": 25.6,
   "text": "Dacă lipsește, e refolosită sau nepotrivită, ori clema e strânsă greșit, gazele scapă pe lângă injector."
  },
  {
   "i": 5,
   "start": 26.05,
   "end": 33.87,
   "text": "La fiecare ardere urcă în puțul injectorului și lasă o calamină foarte tare. Mercedes-Benz îi spune „moartea neagră”."
  },
  {
   "i": 6,
   "start": 34.32,
   "end": 38.42,
   "text": "Injectorul se blochează în chiulasă, iar motorul merge prost."
  },
  {
   "i": 7,
   "start": 38.87,
   "end": 45.46,
   "text": "La mașină: funingine în jurul injectorului, mers neregulat, iar la demontare injectorul nu mai iese."
  },
  {
   "i": 8,
   "start": 45.91,
   "end": 53.005,
   "text": "Cum eviți? La orice demontare: șaibă nouă, scaunul curățat și strângere cu cuplul și unghiul din fabrică."
  },
  {
   "i": 9,
   "start": 53.805,
   "end": 56.995,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 57.395,
   "end": 62.54,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 62.94,
   "end": 66.665,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
