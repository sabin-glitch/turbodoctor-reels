 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 3.19,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.49,
   "end": 8.078,
   "text": "Astăzi prezentăm cauza 3 din 13: depunerile din interior."
  },
  {
   "i": 2,
   "start": 8.428,
   "end": 12.208,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 12.808,
   "end": 18.976,
   "text": "În interior, pe ac și pe pistonul de comandă, se depune în timp o peliculă subțire, ca un lac."
  },
  {
   "i": 4,
   "start": 19.426,
   "end": 27.33,
   "text": "Apare când urme de sodiu din motorină reacționează cu unii aditivi. În teste, au fost de ajuns câteva părți la un milion."
  },
  {
   "i": 5,
   "start": 27.78,
   "end": 34.364,
   "text": "Jocurile sunt de câțiva microni, iar forțele care mișcă piesele sunt mici, așa că pelicula le frânează."
  },
  {
   "i": 6,
   "start": 34.814,
   "end": 38.442,
   "text": "Acul răspunde mai târziu decât comanda, sau rămâne lipit."
  },
  {
   "i": 7,
   "start": 38.892,
   "end": 44.54,
   "text": "La mașină: pornire grea sau imposibilă la rece, mers neregulat și pierdere de putere."
  },
  {
   "i": 8,
   "start": 44.99,
   "end": 50.698,
   "text": "Un semn tipic: testele electrice ies bune, dar injectorul tot nu lucrează cum trebuie."
  },
  {
   "i": 9,
   "start": 51.148,
   "end": 59.536,
   "text": "Cum eviți? Motorină cu aditivi detergenți, de la benzinării serioase. Aditivii buni previn depunerile și le pot chiar curăța."
  },
  {
   "i": 10,
   "start": 60.336,
   "end": 63.526,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 63.926,
   "end": 69.071,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 69.471,
   "end": 73.196,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
