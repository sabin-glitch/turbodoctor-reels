   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.49,
   "end": 8.306,
   "text": "Astăzi prezentăm cauza 12 din 13: defectele electrice."
  },
  {
   "i": 2,
   "start": 8.656,
   "end": 12.436,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 13.036,
   "end": 18.32,
   "text": "La injectorul electromagnetic, o bobină ridică ancora și deschide supapa de comandă."
  },
  {
   "i": 4,
   "start": 18.77,
   "end": 24.69,
   "text": "Bobina se poate întrerupe, poate face scurtcircuit sau își poate pierde izolația față de corp."
  },
  {
   "i": 5,
   "start": 25.14,
   "end": 33.872,
   "text": "La injectorul piezo, teancul de sute de straturi ceramice poate face scurtcircuit sau își pierde capacitatea. Și nu se schimbă separat."
  },
  {
   "i": 6,
   "start": 34.322,
   "end": 40.326,
   "text": "Defectele electrice sunt rare față de cele hidraulice, iar uneori vina e la mufă sau la cablaj."
  },
  {
   "i": 7,
   "start": 40.776,
   "end": 45.476,
   "text": "Cum eviți? Înainte să schimbi injectoare, verifică mufele și cablajul."
  },
  {
   "i": 8,
   "start": 46.276,
   "end": 49.466,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 9,
   "start": 49.866,
   "end": 55.011,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 10,
   "start": 55.411,
   "end": 59.136,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
