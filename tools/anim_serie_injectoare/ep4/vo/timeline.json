 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 3.19,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.49,
   "end": 8.33,
   "text": "Astăzi prezentăm cauza 4 din 13: calamina din găurile duzei."
  },
  {
   "i": 2,
   "start": 8.68,
   "end": 12.46,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 13.06,
   "end": 16.12,
   "text": "Găurile duzei au în jur de o zecime de milimetru."
  },
  {
   "i": 4,
   "start": 16.57,
   "end": 22.282,
   "text": "Motorina rămasă în vârful fierbinte se descompune și lasă calamină în găuri și în jurul lor."
  },
  {
   "i": 5,
   "start": 22.732,
   "end": 28.148,
   "text": "Peste aproximativ 300 de grade la vârful duzei, depunerile cresc mult mai repede."
  },
  {
   "i": 6,
   "start": 28.598,
   "end": 32.406,
   "text": "Iar după oprire, căldura rămasă coace motorina din injector."
  },
  {
   "i": 7,
   "start": 32.856,
   "end": 38.444,
   "text": "Puterea o fură depunerea din interiorul găurii, nu crusta de afară. Jetul se strică."
  },
  {
   "i": 8,
   "start": 38.894,
   "end": 45.206,
   "text": "La mașină: fum, putere mai mică, consum mai mare și probleme repetate cu filtrul de particule."
  },
  {
   "i": 9,
   "start": 45.656,
   "end": 54.816,
   "text": "Cum eviți? Motorină cu aditivi detergenți. În teste, detergenții au recuperat peste trei sferturi din puterea pierdută, cam într-un plin."
  },
  {
   "i": 10,
   "start": 55.616,
   "end": 58.806,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 59.206,
   "end": 64.351,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 64.751,
   "end": 68.476,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
