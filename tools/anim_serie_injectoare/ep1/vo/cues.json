{
 "end": 92.2,
 "lines": [
  {
   "i": 0,
   "start": 0.25,
   "end": 8.005,
   "text": "Seria „De ce se strică injectoarele”. Astăzi prezentăm cauza 1 din 13: particulele din motorină."
  },
  {
   "i": 1,
   "start": 8.355,
   "end": 12.135,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 12.735,
   "end": 19.505,
   "text": "Potrivit Bosch, motorina murdară este cea mai probabilă cauză pentru care un injector cedează înainte de vreme."
  },
  {
   "i": 3,
   "start": 19.955,
   "end": 27.37,
   "text": "Piesele din injector se mișcă la jocuri de 1–4 microni. Un fir de păr are 50–70."
  },
  {
   "i": 4,
   "start": 27.77,
   "end": 33.55,
   "text": "Așa că exact particulele pe care nu le vezi, de câțiva microni, fac cel mai mult rău."
  },
  {
   "i": 5,
   "start": 34.05,
   "end": 42.17,
   "text": "Prima lovită e supapa de comandă: o bilă de un milimetru. Când se ridică, acul deschide. Când închide, injecția se oprește."
  },
  {
   "i": 6,
   "start": 42.62,
   "end": 51.405,
   "text": "Particulele prinse între bilă și scaun lasă mici adâncituri. Când acestea se unesc, motorina sub presiune trece prin ele și sapă un canal."
  },
  {
   "i": 7,
   "start": 51.805,
   "end": 58.145,
   "text": "Supapa nu mai etanșează. Returul crește, iar injectorul dă mai multă motorină și închide mai târziu."
  },
  {
   "i": 8,
   "start": 58.545,
   "end": 63.6,
   "text": "Ca un șmirghel, aceleași particule macină și duza, iar jetul se strică."
  },
  {
   "i": 9,
   "start": 64.05,
   "end": 70.34,
   "text": "La mașină vezi martorul de motor și pierdere de putere. Uneori, motorul se oprește chiar în mers."
  },
  {
   "i": 10,
   "start": 70.84,
   "end": 77.555,
   "text": "Cum eviți? Filtru de calitate, schimbat la intervalul din cartea service, și motorină de la benzinării serioase."
  },
  {
   "i": 11,
   "start": 78.355,
   "end": 81.545,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 81.945,
   "end": 87.09,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 87.49,
   "end": 91.215,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
