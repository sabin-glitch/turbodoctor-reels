   "end": 3.19,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.49,
   "end": 10.226,
   "text": "Astăzi prezentăm cauza 11 din 13: injectorul fără cod și recondiționarea fără standard."
  },
  {
   "i": 2,
   "start": 10.576,
   "end": 14.356,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 14.956,
   "end": 21.24,
   "text": "Fiecare injector are un cod de corecție, scris pe corp, care se introduce în calculator la montaj."
  },
  {
   "i": 4,
   "start": 21.69,
   "end": 26.606,
   "text": "Fără el, calculatorul nu știe cât dă acel injector, iar motorul merge prost."
  },
  {
   "i": 5,
   "start": 27.056,
   "end": 31.652,
   "text": "Al doilea risc e recondiționarea fără stand de testare și fără piese bune."
  },
  {
   "i": 6,
   "start": 32.102,
   "end": 40.426,
   "text": "Bosch a testat injectoare recondiționate în afara rețelei autorizate: în 2013, 70 la sută au picat testele."
  },
  {
   "i": 7,
   "start": 40.876,
   "end": 46.636,
   "text": "Cum eviți? Injector testat pe stand, cu piese bune, și codat în calculator la montaj."
  },
  {
   "i": 8,
   "start": 47.436,
   "end": 50.626,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 9,
   "start": 51.026,
   "end": 56.171,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 10,
   "start": 56.571,
   "end": 60.296,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
