{
 "end": 60.1,
 "lines": [
  {
   "i": 0,
   "start": 0.25,
   "end": 2.97,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.27,
   "end": 8.08,
   "text": "Astăzi prezentăm cauza 10 din 13: pilitura de la pompă."
  },
  {
   "i": 2,
   "start": 8.43,
   "end": 12.21,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 12.81,
   "end": 18.28,
   "text": "Când pompa de înaltă presiune se macină, pilitura pleacă prin rampă în toate injectoarele."
  },
  {
   "i": 4,
   "start": 18.73,
   "end": 22.345,
   "text": "Se depune mai ales la supapa de comandă, în zona bilei."
  },
  {
   "i": 5,
   "start": 22.795,
   "end": 31.45,
   "text": "Buletinele constructorilor spun la fel: dacă găsești metal în pompă, se schimbă pompa, rampa, toate injectoarele, țevile și filtrul."
  },
  {
   "i": 6,
   "start": 31.9,
   "end": 38.9,
   "text": "Rezervorul și conductele se golesc și se spală, iar niciun buletin nu permite curățarea și refolosirea injectoarelor."
  },
  {
   "i": 7,
   "start": 39.35,
   "end": 45.43,
   "text": "Pe scurt: pompa schimbată singură înseamnă injectoare noi, distruse de pilitura rămasă."
  },
  {
   "i": 8,
   "start": 46.23,
   "end": 49.42,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 9,
   "start": 49.82,
   "end": 54.965,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 10,
   "start": 55.365,
   "end": 59.09,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
