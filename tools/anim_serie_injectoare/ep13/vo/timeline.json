   "start": 0.25,
   "end": 2.97,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.27,
   "end": 8.15,
   "text": "Astăzi prezentăm cauza 13 din 13: uzura normală."
  },
  {
   "i": 2,
   "start": 8.5,
   "end": 12.28,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 12.88,
   "end": 17.995,
   "text": "Bosch proiectează sistemul de injecție pentru 300.000 de kilometri la autoturisme."
  },
  {
   "i": 4,
   "start": 18.445,
   "end": 24.585,
   "text": "Delphi dă o durată medie în service de 130 până la 160.000 de kilometri."
  },
  {
   "i": 5,
   "start": 25.035,
   "end": 30.435,
   "text": "Cu timpul apare cavitația la scaunul supapei și la duză, iar arcurile slăbesc."
  },
  {
   "i": 6,
   "start": 30.885,
   "end": 34.11,
   "text": "Returul crește, iar preinjecțiile se pierd."
  },
  {
   "i": 7,
   "start": 34.56,
   "end": 41.4,
   "text": "La mașină: pornire grea, ralanti neregulat și fum. Iar o duză care curge poate topi pistonul."
  },
  {
   "i": 8,
   "start": 41.85,
   "end": 48.24,
   "text": "Cum eviți? La kilometraj mare, test de retur și verificare pe stand, înainte să cedeze un injector."
  },
  {
   "i": 9,
   "start": 49.04,
   "end": 52.23,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 52.63,
   "end": 57.775,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 58.175,
   "end": 61.9,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
