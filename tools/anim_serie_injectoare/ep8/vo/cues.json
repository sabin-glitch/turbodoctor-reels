  {
   "i": 0,
   "start": 0.25,
   "end": 2.97,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.27,
   "end": 8.695,
   "text": "Astăzi prezentăm cauza 8 din 13: AdBlue în rezervorul de motorină."
  },
  {
   "i": 2,
   "start": 9.045,
   "end": 12.825,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 13.425,
   "end": 19.45,
   "text": "AdBlue e uree dizolvată în apă: 32,5 la sută uree, restul apă."
  },
  {
   "i": 4,
   "start": 19.9,
   "end": 24.68,
   "text": "Ajuns în sistemul de motorină, corodează piesele și lasă cristale albe."
  },
  {
   "i": 5,
   "start": 25.13,
   "end": 30.805,
   "text": "Cristalele și coroziunea ajung în pompă și în injectoare, unde jocurile sunt de câțiva microni."
  },
  {
   "i": 6,
   "start": 31.255,
   "end": 36.8,
   "text": "Dacă motorul a fost pornit, General Motors cere înlocuirea întregului sistem de alimentare."
  },
  {
   "i": 7,
   "start": 37.25,
   "end": 41.745,
   "text": "Ce faci? Nu pui contactul. Rezervorul se golește și se spală."
  },
  {
   "i": 8,
   "start": 42.545,
   "end": 45.735,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 9,
   "start": 46.135,
   "end": 51.28,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 10,
   "start": 51.68,
   "end": 55.405,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
