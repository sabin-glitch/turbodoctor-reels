 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 3.19,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.49,
   "end": 7.97,
   "text": "Astăzi prezentăm cauza 9 din 13: motorina care nu unge."
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 12.1,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 12.7,
   "end": 17.644,
   "text": "Motorina e singurul lubrifiant al pompei de înaltă presiune și al injectoarelor."
  },
  {
   "i": 4,
   "start": 18.094,
   "end": 24.97,
   "text": "Producătorii de echipamente de injecție cer o motorină care unge suficient și cel mult 7 la sută biodiesel."
  },
  {
   "i": 5,
   "start": 25.42,
   "end": 31.46,
   "text": "Biodieselul vechi sau prost face acizi și depuneri: filtrele se înfundă și piesele se lipesc."
  },
  {
   "i": 6,
   "start": 31.91,
   "end": 37.35,
   "text": "Uleiul de încălzire nu unge destul, iar uleiul vegetal e prea vâscos și lasă depuneri."
  },
  {
   "i": 7,
   "start": 37.8,
   "end": 42.232,
   "text": "Și când rămâi fără motorină, aerul intrat în sistem împiedică ungerea."
  },
  {
   "i": 8,
   "start": 42.682,
   "end": 48.762,
   "text": "Fără pelicula de motorină, piesele freacă metal pe metal, duzele se lipesc și supapele cedează."
  },
  {
   "i": 9,
   "start": 49.212,
   "end": 56.436,
   "text": "Cum eviți? Motorină standard de la benzinării serioase, fără amestecuri, și nu mergi până la ultima picătură."
  },
  {
   "i": 10,
   "start": 57.236,
   "end": 60.426,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 60.826,
   "end": 65.971,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 66.371,
   "end": 70.096,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
