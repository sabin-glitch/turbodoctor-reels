{
 "end": 60.6,
 "lines": [
  {
   "i": 0,
   "start": 0.25,
   "end": 2.97,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.27,
   "end": 8.325,
   "text": "Astăzi prezentăm cauza 7 din 13: benzina pusă din greșeală."
  },
  {
   "i": 2,
   "start": 8.675,
   "end": 12.455,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 13.055,
   "end": 16.92,
   "text": "Benzina spală pelicula de ungere din pompa de înaltă presiune."
  },
  {
   "i": 4,
   "start": 17.37,
   "end": 22.995,
   "text": "Pompa ajunge să meargă metal pe metal și trimite pilitură în tot sistemul, până în injectoare."
  },
  {
   "i": 5,
   "start": 23.445,
   "end": 30.87,
   "text": "Dacă motorul a mers, reparația poate cuprinde pompa, injectoarele, rampa, țevile, filtrul și rezervorul."
  },
  {
   "i": 6,
   "start": 31.32,
   "end": 35.855,
   "text": "ADAC avertizează că pot face rău și cantitățile mici de benzină."
  },
  {
   "i": 7,
   "start": 36.305,
   "end": 42.305,
   "text": "Ce faci? Nu pui contactul și nu pornești motorul. Chemi tractarea, iar rezervorul se golește."
  },
  {
   "i": 8,
   "start": 42.755,
   "end": 45.94,
   "text": "Iar iarna, nu amesteca motorina cu benzină."
  },
  {
   "i": 9,
   "start": 46.74,
   "end": 49.93,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 50.33,
   "end": 55.475,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 55.875,
   "end": 59.6,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
