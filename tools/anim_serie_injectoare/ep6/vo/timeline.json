 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 3.19,
   "text": "Seria „De ce se strică injectoarele”."
  },
  {
   "i": 1,
   "start": 3.49,
   "end": 8.774,
   "text": "Astăzi prezentăm cauza 6 din 13: murdăria și greșelile de la montaj."
  },
  {
   "i": 2,
   "start": 9.124,
   "end": 12.904,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 3,
   "start": 13.504,
   "end": 19.328,
   "text": "Denso avertizează: murdăria intrată în sistem la montaj poate defecta injectorul imediat."
  },
  {
   "i": 4,
   "start": 19.778,
   "end": 25.75,
   "text": "De aceea, racordurile deschise se acoperă cu capace, iar locul de muncă trebuie să fie curat."
  },
  {
   "i": 5,
   "start": 26.2,
   "end": 32.924,
   "text": "Țevile de înaltă presiune nu se refolosesc: conul se deformează la strângere și se pot desprinde așchii."
  },
  {
   "i": 6,
   "start": 33.374,
   "end": 40.474,
   "text": "Contează și cuplurile de strângere, returul liber și aerisirea: aerul lăsat după reparație împiedică ungerea."
  },
  {
   "i": 7,
   "start": 40.924,
   "end": 46.228,
   "text": "Bosch pune montajul greșit printre cele trei cauze cheie ale defectării injectoarelor."
  },
  {
   "i": 8,
   "start": 46.678,
   "end": 53.962,
   "text": "Cum eviți? Injectoarele se montează în service, cu curățenie de laborator, țevi noi și cupluri după fabricant."
  },
  {
   "i": 9,
   "start": 54.762,
   "end": 57.952,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 58.352,
   "end": 63.497,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 63.897,
   "end": 67.622,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
