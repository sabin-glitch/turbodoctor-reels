 "cold_words": [],
 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.3,
   "end": 8.85,
   "text": "Eroarea P2002, eficiență filtru de particule. Ce înseamnă, de cele mai multe ori, pe motoarele 2.0 Euro 6 de pe gama VAG?"
  },
  {
   "i": 1,
   "start": 9.4,
   "end": 16.43,
   "text": "De cele mai multe ori, filtrul nu are nimic. Problema e la EGR și la răcitorul de gaze. Hai să-ți arăt de ce."
  },
  {
   "i": 2,
   "start": 17.03,
   "end": 22.68,
   "text": "Gazele ies din motor și trec prin turbină, prin catalizator și prin filtrul de particule."
  },
  {
   "i": 3,
   "start": 23.08,
   "end": 29.525,
   "text": "După filtru, o parte din ele se întoarce în admisie, prin răcitorul de gaze și prin supapa EGR."
  },
  {
   "i": 4,
   "start": 29.975,
   "end": 34.975,
   "text": "În filtru, gazele trec prin pereții poroși, iar funinginea rămâne în canale."
  },
  {
   "i": 5,
   "start": 35.425,
   "end": 40.565,
   "text": "Calculatorul nu vede în filtru. Măsoară doar presiunea, înainte și după el."
  },
  {
   "i": 6,
   "start": 40.965,
   "end": 49.19,
   "text": "Separat, calculează câtă funingine ar trebui să fie acolo. Dacă măsoară mult mai puțin, crede că filtrul nu mai reține și dă eroarea."
  },
  {
   "i": 7,
   "start": 49.84,
   "end": 57.835,
   "text": "Cel mai des, de vină e răcitorul de gaze. Se înfundă cu depuneri, iar prin el trec mai puține gaze decât a socotit calculatorul."
  },
  {
   "i": 8,
   "start": 58.235,
   "end": 63.91,
   "text": "Presiunea pe filtru iese mai mică decât cea așteptată. Apare eroarea, deși filtrul e bun."
  },
  {
   "i": 9,
   "start": 64.36,
   "end": 69.83,
   "text": "Uneori, răcitorul e și fisurat: pierde antigel, fără nicio pată sub mașină."
  },
  {
   "i": 10,
   "start": 70.43,
   "end": 78.19,
   "text": "A doua cauză e supapa EGR. Înțepenită de depuneri, nu se mai deschide cât i se cere. Efectul e același."
  },
  {
   "i": 11,
   "start": 78.79,
   "end": 87.96,
   "text": "Aceeași eroare o dă și un furtunaș crăpat sau înfundat, la senzorul de presiune. Sau aerul pierdut pe admisie și un debitmetru care măsoară greșit."
  },
  {
   "i": 12,
   "start": 88.56,
   "end": 96.08,
   "text": "Sunt și cazuri în care filtrul chiar are de suferit. Un injector care picură face mai multă funingine decât e în calcul."
  },
  {
   "i": 13,
   "start": 96.48,
   "end": 102.7,
   "text": "Filtrul regenerează des și foarte fierbinte, până crapă. Iar unul nou pățește la fel."
  },
  {
   "i": 14,
   "start": 103.25,
   "end": 112.165,
   "text": "Mai e și uleiul: trecut de segmenți sau scăpat pe la axul turbinei, arde și lasă cenușă. Iar cenușa nu mai iese din filtru la regenerare."
  },
  {
   "i": 15,
   "start": 112.815,
   "end": 120.945,
   "text": "Așa că, înainte să schimbi filtrul, caută cauza. Eroarea arată spre filtru, dar cauza se găsește la diagnoză."
  }
 ]
}