 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 7.765,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 13 din 13: uzura motorului."
  },
  {
   "i": 1,
   "start": 8.115,
   "end": 11.895,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 12.495,
   "end": 18.615,
   "text": "Când segmenții și cilindrii se uzează, o parte din gazele de ardere scapă pe lângă piston, în carter."
  },
  {
   "i": 3,
   "start": 19.015,
   "end": 25.455,
   "text": "În carter crește presiunea. Uleiul din turbină nu se mai poate scurge și este împins afară pe lângă etanșări."
  },
  {
   "i": 4,
   "start": 25.855,
   "end": 31.545,
   "text": "Aceleași gaze aduc funingine în ulei, iar uleiul murdar zgârie lagărele turbinei."
  },
  {
   "i": 5,
   "start": 31.945,
   "end": 36.975,
   "text": "Vezi fum albastru, consum de ulei și ulei la ambele capete ale turbinei."
  },
  {
   "i": 6,
   "start": 37.375,
   "end": 43.05,
   "text": "Aici turbina este martorul, nu bolnavul. Dacă o schimbi, cea nouă pățește la fel."
  },
  {
   "i": 7,
   "start": 43.45,
   "end": 49.555,
   "text": "Un mare producător spune că o turbină ține de obicei cât motorul, dacă motorul este sănătos."
  },
  {
   "i": 8,
   "start": 49.955,
   "end": 55.485,
   "text": "Cum eviți? Înainte de a schimba turbina, verifici presiunea din carter și starea motorului."
  },
  {
   "i": 9,
   "start": 56.285,
   "end": 59.475,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 59.875,
   "end": 65.02,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 65.42,
   "end": 69.145,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
