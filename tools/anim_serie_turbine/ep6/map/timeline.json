 "cold_words": [],
 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 8.17,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 6 din 13: corpurile străine din evacuare."
  },
  {
   "i": 1,
   "start": 8.52,
   "end": 12.3,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 12.9,
   "end": 17.705,
   "text": "Tot ce iese din cilindru trece prin galeria de evacuare direct în roata turbinei."
  },
  {
   "i": 3,
   "start": 18.105,
   "end": 25.23,
   "text": "Dacă în motor se rupe o supapă, un segment sau o bucată din galerie, bucata ajunge direct în paletele turbinei."
  },
  {
   "i": 4,
   "start": 25.63,
   "end": 30.965,
   "text": "Muchiile de intrare ale paletelor se rup, iar paletele geometriei variabile se îndoaie."
  },
  {
   "i": 5,
   "start": 31.365,
   "end": 36.565,
   "text": "Cu palete rupte, rotorul rămâne dezechilibrat, iar turbina nu mai are mult."
  },
  {
   "i": 6,
   "start": 36.965,
   "end": 41.305,
   "text": "Aici turbina este victima. Defectul a pornit din motor."
  },
  {
   "i": 7,
   "start": 41.705,
   "end": 48.315,
   "text": "Dacă pui o turbină nouă fără să repari motorul și fără să cureți galeria, resturile rămase o distrug și pe ea."
  },
  {
   "i": 8,
   "start": 48.715,
   "end": 55.985,
   "text": "Cum eviți? Înainte de turbina nouă, găsești de unde a venit bucata, repari motorul și cureți galeria de evacuare."
  },
  {
   "i": 9,
   "start": 56.785,
   "end": 59.975,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 60.375,
   "end": 65.52,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 65.92,
   "end": 69.645,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
}