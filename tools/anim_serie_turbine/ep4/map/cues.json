 "lines": [
  {
   "i": 0,
   "start": 0.25,
   "end": 8.405,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 4 din 13: uleiul care nu se mai poate scurge."
  },
  {
   "i": 1,
   "start": 8.755,
   "end": 12.535,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 13.135,
   "end": 19.215,
   "text": "Uleiul intră în turbină sub presiune, dar iese singur, prin conducta de retur, înapoi în baia de ulei."
  },
  {
   "i": 3,
   "start": 19.615,
   "end": 25.185,
   "text": "Dacă returul este înfundat cu calamină sau îndoit, uleiul nu mai are pe unde să iasă."
  },
  {
   "i": 4,
   "start": 25.585,
   "end": 33.685,
   "text": "La fel se întâmplă când în carter este presiune: ventilația carterului înfundată sau segmenți uzați. Sunt de ajuns câțiva milibari."
  },
  {
   "i": 5,
   "start": 34.085,
   "end": 39.85,
   "text": "Uleiul se adună în turbină și este împins afară pe lângă etanșări, în admisie și în evacuare."
  },
  {
   "i": 6,
   "start": 40.25,
   "end": 47.88,
   "text": "Vezi fum albastru, ulei în intercooler și consum de ulei. Pare că turbina este defectă, dar cauza este în altă parte."
  },
  {
   "i": 7,
   "start": 48.28,
   "end": 55.165,
   "text": "Uleiul ars încleiază geometria variabilă, iar uleiul ajuns în admisie poate duce la supraturări necontrolate."
  },
  {
   "i": 8,
   "start": 55.565,
   "end": 58.555,
   "text": "Dacă schimbi doar turbina, problema rămâne."
  },
  {
   "i": 9,
   "start": 58.955,
   "end": 66.795,
   "text": "Cum eviți? Retur curat și montat corect, fără silicon, ventilația carterului verificată și ulei doar până la maxim."
  },
  {
   "i": 10,
   "start": 67.595,
   "end": 70.785,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 71.185,
   "end": 76.33,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 76.73,
   "end": 80.455,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
