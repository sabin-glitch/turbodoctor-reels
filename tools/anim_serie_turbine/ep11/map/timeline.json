 "cold_words": [],
 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 10.15,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 11 din 13: scăpările și înfundările de pe traseul de aer și de gaze."
  },
  {
   "i": 1,
   "start": 10.5,
   "end": 14.28,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 14.88,
   "end": 21.415,
   "text": "Turbina lucrează împreună cu tot traseul de aer și de gaze. Orice scăpare sau înfundare se simte în ea."
  },
  {
   "i": 3,
   "start": 21.815,
   "end": 29.89,
   "text": "Un filtru de aer înfundat o obligă să tragă aerul cu forța. La intrarea în compresor se face vid, care trage ulei pe lângă etanșare."
  },
  {
   "i": 4,
   "start": 30.29,
   "end": 36.795,
   "text": "Un furtun fisurat sau un colier slăbit pierde presiune, iar turbina se învârte mai repede ca să compenseze."
  },
  {
   "i": 5,
   "start": 37.195,
   "end": 44.535,
   "text": "O galerie de evacuare crăpată sau o garnitură lipsă îi fură energia: gazele scapă înainte să ajungă la turbină."
  },
  {
   "i": 6,
   "start": 44.935,
   "end": 49.965,
   "text": "Iar un eșapament sau un catalizator înfundat ține gazele și căldura în turbină."
  },
  {
   "i": 7,
   "start": 50.365,
   "end": 56.06,
   "text": "Semnele sunt șuieratul, fumul negru, lipsa de putere și uleiul la compresor."
  },
  {
   "i": 8,
   "start": 56.46,
   "end": 63.95,
   "text": "Cum eviți? Filtru de aer schimbat la timp, furtunuri și coliere verificate, iar un șuierat nou apărut nu se ignoră."
  },
  {
   "i": 9,
   "start": 64.75,
   "end": 67.94,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 68.34,
   "end": 73.485,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 73.885,
   "end": 77.61,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
}