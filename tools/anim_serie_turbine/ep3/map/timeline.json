 "cold_words": [],
 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 7.88,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 3 din 13: oprirea motorului la cald."
  },
  {
   "i": 1,
   "start": 8.23,
   "end": 12.01,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 12.61,
   "end": 18.13,
   "text": "După un drum lung pe autostradă sau o urcare grea, turbina este foarte fierbinte."
  },
  {
   "i": 3,
   "start": 18.53,
   "end": 22.785,
   "text": "Cât merge motorul, uleiul curge prin ea și duce căldura cu el."
  },
  {
   "i": 4,
   "start": 23.185,
   "end": 28.465,
   "text": "Dacă oprești motorul imediat, se oprește și pompa de ulei. Uleiul rămâne pe loc."
  },
  {
   "i": 5,
   "start": 28.865,
   "end": 34.28,
   "text": "Căldura din partea de evacuare trece în lagăre și coace uleiul. Se formează calamină."
  },
  {
   "i": 6,
   "start": 34.68,
   "end": 41.53,
   "text": "Calamina înfundă canalele de ulei și returul. La fiecare pornire, lagărele primesc tot mai puțin ulei."
  },
  {
   "i": 7,
   "start": 41.93,
   "end": 47.435,
   "text": "Primele care cedează sunt lagărul dinspre evacuare și segmentul de etanșare de pe ax."
  },
  {
   "i": 8,
   "start": 47.835,
   "end": 55.435,
   "text": "Cum eviți? După un drum greu, lași motorul la ralanti. Producătorii de turbine recomandă între un minut și trei minute."
  },
  {
   "i": 9,
   "start": 55.835,
   "end": 60.265,
   "text": "Și mergi liniștit pe ultimii kilometri, ca turbina să apuce să se răcească."
  },
  {
   "i": 10,
   "start": 61.065,
   "end": 64.255,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 64.655,
   "end": 69.8,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 70.2,
   "end": 73.925,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
}