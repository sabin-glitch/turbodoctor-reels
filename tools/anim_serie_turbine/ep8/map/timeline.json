 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 7.425,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 8 din 13: supraturarea."
  },
  {
   "i": 1,
   "start": 7.775,
   "end": 11.555,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 12.155,
   "end": 19.825,
   "text": "Fiecare turbină are o turație maximă. Peste ea, forța centrifugă întinde roata compresorului, care este din aluminiu."
  },
  {
   "i": 3,
   "start": 20.225,
   "end": 24.285,
   "text": "Roata crește în diametru, atinge carcasa și se poate rupe."
  },
  {
   "i": 4,
   "start": 24.685,
   "end": 30.555,
   "text": "Pe spatele roții rămâne un aspect de coajă de portocală. Este semnul clar al supraturării."
  },
  {
   "i": 5,
   "start": 30.955,
   "end": 33.655,
   "text": "Totul se poate întâmpla în câteva secunde."
  },
  {
   "i": 6,
   "start": 34.055,
   "end": 45.045,
   "text": "De unde vine? Dintr-un soft modificat, din geometria variabilă blocată pe închis de calamină sau dintr-un defect la comanda ei: un furtunaș fisurat, actuatorul ori membrana lui."
  },
  {
   "i": 7,
   "start": 45.445,
   "end": 49.15,
   "text": "Supraturările repetate obosesc și roata turbinei."
  },
  {
   "i": 8,
   "start": 49.55,
   "end": 58.6,
   "text": "Cum eviți? Fără soft care ridică presiunea peste limita turbinei, cu geometria variabilă curată și cu comanda ei verificată la primul mod de avarie."
  },
  {
   "i": 9,
   "start": 59.4,
   "end": 62.59,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 62.99,
   "end": 68.135,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 68.535,
   "end": 72.26,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
