 "cold_words": [],
 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.25,
   "end": 7.345,
   "text": "Seria „De ce se strică turbinele”. Astăzi prezentăm cauza 1 din 13: lipsa ungerii."
  },
  {
   "i": 1,
   "start": 7.695,
   "end": 11.475,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 12.075,
   "end": 19.765,
   "text": "Axul turbinei se învârte cu până la 300.000 de rotații pe minut și nu atinge metalul. Plutește pe un film subțire de ulei."
  },
  {
   "i": 3,
   "start": 20.165,
   "end": 24.365,
   "text": "Când uleiul nu mai ajunge la lagăre, metalul freacă pe metal."
  },
  {
   "i": 4,
   "start": 24.765,
   "end": 31.12,
   "text": "Lagărele se încing, se gripează, iar axul se rupe. Totul se întâmplă în foarte scurt timp."
  },
  {
   "i": 5,
   "start": 31.52,
   "end": 39.18,
   "text": "De ce nu mai ajunge uleiul? Nivel scăzut în baie, o pompă de ulei slăbită sau depuneri pe conducta de alimentare a turbinei."
  },
  {
   "i": 6,
   "start": 39.58,
   "end": 44.045,
   "text": "Se mai întâmplă la o turbină nouă, pornită fără să fie amorsată cu ulei."
  },
  {
   "i": 7,
   "start": 44.445,
   "end": 50.03,
   "text": "Sau când turezi motorul imediat după pornirea la rece, înainte ca uleiul să ajungă la turbină."
  },
  {
   "i": 8,
   "start": 50.43,
   "end": 57.875,
   "text": "Cum eviți? Ulei la nivel și schimbat la timp, conducte de ulei curate și fără turații mari în primele secunde după pornire."
  },
  {
   "i": 9,
   "start": 58.675,
   "end": 61.865,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 10,
   "start": 62.265,
   "end": 67.41,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 11,
   "start": 67.81,
   "end": 71.535,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
}