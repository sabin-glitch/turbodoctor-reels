 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.16,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 13 din 17: tachetul pompei CP4."
  },
  {
   "i": 1,
   "start": 12.51,
   "end": 16.29,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.89,
   "end": 26.588,
   "text": "Semnele: martorul de motor, pornire grea, pierdere de putere, zgomot de bătaie mai tare ca de obicei, apoi avarie sau motor oprit în mers."
  },
  {
   "i": 3,
   "start": 27.008,
   "end": 36.623,
   "text": "Pompa CP4 e pe foarte multe diesele moderne. Pe arborele ei e o camă, iar pe camă calcă o rolă ținută într-un tachet, care împinge pistonul."
  },
  {
   "i": 4,
   "start": 37.043,
   "end": 45.489,
   "text": "Cât timp rola stă dreaptă, se rostogolește pe camă, pe o peliculă de motorină. Numai că tachetul e rotund și se poate răsuci în locașul lui."
  },
  {
   "i": 5,
   "start": 45.909,
   "end": 54.049,
   "text": "Când ungerea slăbește, din cauza aerului, a benzinei sau a unei motorine care nu unge, rola se poate întoarce cu un sfert de tură."
  },
  {
   "i": 6,
   "start": 54.469,
   "end": 60.499,
   "text": "Din clipa aceea nu se mai rostogolește. Alunecă de-a latul pe camă și taie un șanț în mijlocul ei."
  },
  {
   "i": 7,
   "start": 60.919,
   "end": 66.944,
   "text": "Metalul ros pleacă sub formă de fulgi fini în toată instalația, până în injectoare și în rezervor."
  },
  {
   "i": 8,
   "start": 67.444,
   "end": 75.909,
   "text": "Cum eviți: tot ce ține pelicula întreagă. Filtru schimbat și aerisit corect, rezervor care nu ajunge la fund și niciodată benzină."
  },
  {
   "i": 9,
   "start": 76.509,
   "end": 84.774,
   "text": "Ce facem noi la Turbo Doctor: recondiționăm pompele CP4. Căutăm pilitura la microscop și verificăm cama, rola și tachetul."
  },
  {
   "i": 10,
   "start": 85.194,
   "end": 93.304,
   "text": "Piesele roase se înlocuiesc cu piese noi, iar pompa e testată pe banc. Verificăm pe stand și injectoarele, la care au ajuns fulgii."
  },
  {
   "i": 11,
   "start": 94.104,
   "end": 97.294,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 97.694,
   "end": 102.839,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 103.239,
   "end": 106.964,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
