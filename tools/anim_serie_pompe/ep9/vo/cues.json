{
 "end": 104.76666666666667,
 "lines": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.235,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 9 din 17: filtrul înfundat și motorina înghețată."
  },
  {
   "i": 1,
   "start": 12.585,
   "end": 16.365,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.965,
   "end": 26.38,
   "text": "Semnele: motorul nu mai trage la depășire sau în rampă, intră în avarie ori se oprește. Iarna, la ger, se oprește la scurt timp după pornire."
  },
  {
   "i": 3,
   "start": 26.8,
   "end": 33.919,
   "text": "Pompa de înaltă presiune nu poate comprima decât motorina pe care o primește. Iar tot ce primește trece întâi prin filtru."
  },
  {
   "i": 4,
   "start": 34.339,
   "end": 43.574,
   "text": "Un filtru încărcat lasă să treacă destulă motorină la ralanti. La accelerare, când motorul cere mult, debitul e strangulat și presiunea din rampă cade."
  },
  {
   "i": 5,
   "start": 43.994,
   "end": 53.579,
   "text": "Iarna, același lucru îl face frigul. De pe la minus șapte grade, în motorină apar primele cristale de parafină, iar la ger puternic ele astupă filtrul."
  },
  {
   "i": 6,
   "start": 53.999,
   "end": 63.889,
   "text": "O pompă înfometată nu doar că pierde presiune. Motorina o unge și o răcește, așa că, la debit mic, piesele ei lucrează mai cald și cu o peliculă mai subțire."
  },
  {
   "i": 7,
   "start": 64.389,
   "end": 73.129,
   "text": "Cum eviți: schimbă filtrul la interval, de preferat înainte de iarnă. Pe ger, alimentează cu motorină de iarnă și nu turna benzină în ea."
  },
  {
   "i": 8,
   "start": 73.729,
   "end": 80.709,
   "text": "Ce facem noi la Turbo Doctor: o pompă acuzată pe nedrept se vede pe banc. O testăm cu alimentare corectă."
  },
  {
   "i": 9,
   "start": 81.129,
   "end": 90.114,
   "text": "Dacă dă debitul și presiunea din fișă, pompa e bună, iar problema e la filtru sau la alimentare. Dacă nu le dă, o desfacem și o recondiționăm."
  },
  {
   "i": 10,
   "start": 90.914,
   "end": 94.104,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 94.504,
   "end": 99.649,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 100.049,
   "end": 103.774,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
