 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.705,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 14 din 17: uzura normală și garniturile îmbătrânite."
  },
  {
   "i": 1,
   "start": 13.055,
   "end": 16.835,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 17.435,
   "end": 27.09,
   "text": "Semnele vin încet: pornire tot mai grea, mai ales cu motorul cald, putere mai mică la turații mari și, uneori, urme umede de motorină pe pompă."
  },
  {
   "i": 3,
   "start": 27.51,
   "end": 34.025,
   "text": "Pistoanele pompei fac milioane de curse la fiecare mie de kilometri, la presiuni de peste două mii de bari."
  },
  {
   "i": 4,
   "start": 34.445,
   "end": 42.355,
   "text": "Cu timpul, jocul dintre piston și cilindru crește. O parte din motorină scapă înapoi pe lângă piston, în loc să ajungă în rampă."
  },
  {
   "i": 5,
   "start": 42.775,
   "end": 50.545,
   "text": "La cald, motorina e mai subțire și scapă și mai ușor. De aceea, la demaror, o pompă uzată nu mai strânge presiunea de pornire."
  },
  {
   "i": 6,
   "start": 50.965,
   "end": 57.945,
   "text": "Îmbătrânesc și garniturile. Se întăresc, crapă și lasă motorina să iasă pe la ax sau pe la capace."
  },
  {
   "i": 7,
   "start": 58.365,
   "end": 64.047,
   "text": "Uzura normală nu vine peste noapte și, de obicei, nu umple instalația de pilitură."
  },
  {
   "i": 8,
   "start": 64.547,
   "end": 70.917,
   "text": "Cum eviți surprizele: filtre schimbate la timp, motorină curată și o verificare la primele semne."
  },
  {
   "i": 9,
   "start": 71.517,
   "end": 80.697,
   "text": "Ce facem noi la Turbo Doctor: măsurăm pe banc cât debit mai dă pompa la presiune mare și îi verificăm etanșeitatea. Uneori ajung garnituri noi."
  },
  {
   "i": 10,
   "start": 81.117,
   "end": 91.317,
   "text": "Dacă pistoanele sau supapele sunt uzate, le înlocuim cu piese noi și testăm pompa din nou. Primești fișa de test și garanție de douăsprezece luni, fără limită de kilometri."
  },
  {
   "i": 11,
   "start": 92.117,
   "end": 95.307,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 95.707,
   "end": 100.852,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 101.252,
   "end": 104.977,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
