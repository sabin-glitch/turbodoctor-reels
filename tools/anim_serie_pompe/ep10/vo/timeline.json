 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.62,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 10 din 17: pompa de alimentare din rezervor, slăbită."
  },
  {
   "i": 1,
   "start": 12.97,
   "end": 16.75,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 17.35,
   "end": 24.88,
   "text": "Semnele: pornire grea, lipsă de putere la accelerare și, uneori, un bâzâit mai puternic din zona rezervorului."
  },
  {
   "i": 3,
   "start": 25.3,
   "end": 34.47,
   "text": "La multe diesele moderne, pompa de înaltă presiune nu trage singură motorina. O primește, sub presiune, de la o pompă electrică scufundată în rezervor."
  },
  {
   "i": 4,
   "start": 34.89,
   "end": 43.795,
   "text": "Pompa electrică se uzează și ea. I se înfundă sita cu murdăria din rezervor ori i se încing contactele, și nu mai dă presiunea și debitul de la început."
  },
  {
   "i": 5,
   "start": 44.215,
   "end": 53.905,
   "text": "Pompa de înaltă presiune rămâne cu prea puțină motorină. Nu mai ține presiunea în rampă, iar piesele ei, unse și răcite tot de motorină, se uzează mai repede."
  },
  {
   "i": 6,
   "start": 54.325,
   "end": 62.721,
   "text": "De aici vine o greșeală scumpă: se schimbă pompa de înaltă presiune, iar defectul rămâne, pentru că vinovata era cea din rezervor."
  },
  {
   "i": 7,
   "start": 63.221,
   "end": 71.328,
   "text": "Cum eviți: nu merge cu rezervorul aproape gol, pentru că pompa electrică e răcită de motorina din jurul ei, și schimbă filtrul la timp."
  },
  {
   "i": 8,
   "start": 71.928,
   "end": 81.388,
   "text": "Ce facem noi la Turbo Doctor: testul pe banc desparte cele două pompe. Dacă pompa de înaltă presiune dă debitul și presiunea din fișă, nu o schimbi degeaba."
  },
  {
   "i": 9,
   "start": 81.808,
   "end": 87.698,
   "text": "Dacă a lucrat mult timp flămândă și s-a uzat, o recondiționăm, cu garanție de douăsprezece luni."
  },
  {
   "i": 10,
   "start": 88.498,
   "end": 91.688,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 92.088,
   "end": 97.233,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 97.633,
   "end": 101.358,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
