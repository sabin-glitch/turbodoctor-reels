 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 11.77,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 17 din 17: pompa la mâna a doua."
  },
  {
   "i": 1,
   "start": 12.12,
   "end": 15.9,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.5,
   "end": 27.11,
   "text": "Semnele: după montarea unei pompe folosite, mașina merge o vreme, apoi vin pornirea grea, pierderea de putere și erorile de presiune. Uneori urmează injectoarele."
  },
  {
   "i": 3,
   "start": 27.53,
   "end": 37.495,
   "text": "O pompă nu se poate judeca din ochi. Uzura ei e înăuntru, pe camă, pe pistoane și pe supape. Pe dinafară, una bună și una roasă arată la fel."
  },
  {
   "i": 4,
   "start": 37.915,
   "end": 46.1,
   "text": "O pompă de la dezmembrări vine fără poveste. Nu știi câți kilometri are, cu ce motorină a mers și de ce a ajuns mașina la dezmembrat."
  },
  {
   "i": 5,
   "start": 46.52,
   "end": 55.2,
   "text": "Poate a stat luni de zile pe un raft, cu racordurile deschise: înăuntru intră praf și umezeală, iar motorina rămasă se învechește și lasă depuneri."
  },
  {
   "i": 6,
   "start": 55.62,
   "end": 63.0,
   "text": "Dacă e deja roasă, face pilitură în mașina ta. Iar pilitura ajunge în injectoare, în rampă și în rezervor."
  },
  {
   "i": 7,
   "start": 63.5,
   "end": 72.52,
   "text": "Cum eviți: dacă tot cumperi o pompă folosită, nu o monta netestată. Un test pe banc costă mult mai puțin decât o instalație plină de pilitură."
  },
  {
   "i": 8,
   "start": 73.12,
   "end": 79.82,
   "text": "Ce facem noi la Turbo Doctor: testăm pe banc și pompa adusă de tine. Sau o recondiționăm pe cea de pe mașina ta."
  },
  {
   "i": 9,
   "start": 80.24,
   "end": 90.185,
   "text": "O desfacem, o curățăm cu ultrasunete, înlocuim piesele uzate cu piese noi și o testăm. O primești înapoi cu fișa de test și cu garanție de douăsprezece luni."
  },
  {
   "i": 10,
   "start": 90.985,
   "end": 94.175,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 94.575,
   "end": 99.72,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 100.12,
   "end": 103.845,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
