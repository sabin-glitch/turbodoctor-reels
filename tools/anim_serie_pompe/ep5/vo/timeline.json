 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.224,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 5 din 17: particulele și filtrul neschimbat."
  },
  {
   "i": 1,
   "start": 12.574,
   "end": 16.354,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.954,
   "end": 25.184,
   "text": "Semnele vin treptat: motorul trage tot mai slab, pornește tot mai greu, iar la un moment dat apare eroarea de presiune în rampă."
  },
  {
   "i": 3,
   "start": 25.604,
   "end": 34.819,
   "text": "Ca să ridice presiunea la peste două mii de bari, pistoanele pompei lucrează în cilindri cu jocuri de câțiva microni. Un fir de păr e de zeci de ori mai gros."
  },
  {
   "i": 4,
   "start": 35.239,
   "end": 45.104,
   "text": "Filtrul de motorină oprește particulele care ar intra în aceste jocuri. Un filtru vechi, ieftin sau nepotrivit lasă să treacă praf, rugină și nisip fin."
  },
  {
   "i": 5,
   "start": 45.524,
   "end": 55.164,
   "text": "Particulele ajung între piston și cilindru și între camă și rolă. Zgârie suprafețele ca un șmirghel, iar pompa începe să piardă presiune pe lângă piston."
  },
  {
   "i": 6,
   "start": 55.584,
   "end": 63.644,
   "text": "Din zgârieturi se desprinde metal, adică și mai multe particule. Uzura se hrănește singură și merge mai departe, spre injectoare."
  },
  {
   "i": 7,
   "start": 64.144,
   "end": 73.529,
   "text": "Cum eviți: schimbă filtrul de motorină la intervalul din cartea mașinii, cu unul de calitate, potrivit motorului. Iar la montaj, nu-l lăsa desfăcut în praf."
  },
  {
   "i": 8,
   "start": 74.129,
   "end": 81.069,
   "text": "Ce facem noi la Turbo Doctor: la demontare, verificăm pompa la microscop, de pilitură, mizerie și fisuri."
  },
  {
   "i": 9,
   "start": 81.409,
   "end": 86.094,
   "text": "Curățăm piesele cu ultrasunete și le înlocuim pe cele zgâriate cu piese noi."
  },
  {
   "i": 10,
   "start": 86.514,
   "end": 93.254,
   "text": "Apoi testăm pompa pe banc. Iar pentru că aceleași particule ajung și la injectoare, le verificăm și pe ele pe stand."
  },
  {
   "i": 11,
   "start": 94.054,
   "end": 97.244,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 97.644,
   "end": 102.789,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 103.189,
   "end": 106.914,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
