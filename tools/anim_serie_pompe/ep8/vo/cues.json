{
 "end": 104.06666666666666,
 "lines": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.715,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 8 din 17: motorina îmbătrânită și bacteriile din rezervor."
  },
  {
   "i": 1,
   "start": 13.065,
   "end": 16.845,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 17.445,
   "end": 27.665,
   "text": "Semnele apar la mașinile care stau: după luni de pauză, motorul nu pornește sau pornește și se oprește, iar filtrul e plin de nămol închis la culoare."
  },
  {
   "i": 3,
   "start": 28.085,
   "end": 37.535,
   "text": "Motorina de azi conține până la șapte la sută biodiesel. Biodieselul unge bine, dar îmbătrânește: cu aerul și cu căldura, se oxidează."
  },
  {
   "i": 4,
   "start": 37.955,
   "end": 45.275,
   "text": "Din oxidare rezultă acizi, care atacă metalul, și rășini lipicioase, care se depun ca un lac pe piesele calde."
  },
  {
   "i": 5,
   "start": 45.695,
   "end": 53.465,
   "text": "Lacul umple jocurile de câțiva microni. Pistoanele pompei și regulatorul de debit se mișcă tot mai greu și pot rămâne înțepenite."
  },
  {
   "i": 6,
   "start": 53.885,
   "end": 63.9,
   "text": "Dacă în rezervor s-a adunat și apă, la limita dintre apă și motorină cresc bacterii și ciuperci. Ele fac un nămol care înfundă filtrul și lasă pompa fără motorină."
  },
  {
   "i": 7,
   "start": 64.4,
   "end": 72.685,
   "text": "Cum eviți: o mașină care stă mult se lasă cu rezervorul plin, cu motorină proaspătă, iar la repunerea în mers i se schimbă filtrul."
  },
  {
   "i": 8,
   "start": 73.285,
   "end": 83.475,
   "text": "Ce facem noi la Turbo Doctor: o pompă înțepenită de depuneri nu e neapărat pierdută. O desfacem, curățăm piesele cu ultrasunete și schimbăm garniturile și piesele corodate."
  },
  {
   "i": 9,
   "start": 83.895,
   "end": 89.41,
   "text": "Apoi o testăm pe banc. La fel procedăm cu injectoarele, care suferă de aceleași depuneri."
  },
  {
   "i": 10,
   "start": 90.21,
   "end": 93.4,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 93.8,
   "end": 98.945,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 99.345,
   "end": 103.07,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
