 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.015,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 1 din 17: aerul rămas după schimbul de filtru."
  },
  {
   "i": 1,
   "start": 12.365,
   "end": 16.145,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.745,
   "end": 25.265,
   "text": "Semnele apar după un schimb de filtru de motorină: demarorul învârte mult, motorul pornește greu sau se oprește după câteva secunde."
  },
  {
   "i": 3,
   "start": 25.685,
   "end": 32.41,
   "text": "Pompa de înaltă presiune nu are ulei. Piesele ei sunt unse și răcite chiar de motorina pe care o pompează."
  },
  {
   "i": 4,
   "start": 32.83,
   "end": 40.49,
   "text": "Un filtru nou, montat gol, e plin de aer. Dacă motorul e pornit așa, în pompă ajunge întâi aerul, nu motorina."
  },
  {
   "i": 5,
   "start": 40.91,
   "end": 48.15,
   "text": "Fără pelicula de motorină, cama, rola și pistonul lucrează metal pe metal, iar suprafețele lor se zgârie."
  },
  {
   "i": 6,
   "start": 48.57,
   "end": 56.87,
   "text": "Din zgârieturi se desprinde pilitură fină. Motorul pornește până la urmă, dar uzura a început și merge mai departe la fiecare drum."
  },
  {
   "i": 7,
   "start": 57.29,
   "end": 66.645,
   "text": "Pilitura pleacă odată cu motorina: la regulatorul de debit, în rampă și în injectoare. Prin retur ajunge în rezervor, iar de acolo, din nou spre pompă."
  },
  {
   "i": 8,
   "start": 67.145,
   "end": 77.68,
   "text": "Cum eviți: după schimbul filtrului, instalația se umple și se aerisește înainte de pornire, după procedura mașinii. Motorul nu se pornește ca să tragă singur motorina."
  },
  {
   "i": 9,
   "start": 78.28,
   "end": 86.102,
   "text": "Ce facem noi la Turbo Doctor: desfacem pompa și o verificăm la microscop. Dacă găsim pilitură, o recondiționăm cu piese noi."
  },
  {
   "i": 10,
   "start": 86.522,
   "end": 95.067,
   "text": "Apoi o testăm pe banc, la debit, presiune și etanșeitate. Iar injectoarele, la care a ajuns aceeași pilitură, le verificăm pe stand."
  },
  {
   "i": 11,
   "start": 95.867,
   "end": 99.057,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 99.457,
   "end": 104.602,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 105.002,
   "end": 108.727,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
