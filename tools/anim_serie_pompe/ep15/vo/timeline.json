 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 11.67,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 15 din 17: greșelile de montaj."
  },
  {
   "i": 1,
   "start": 12.02,
   "end": 15.8,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.4,
   "end": 26.01,
   "text": "Semnele apar imediat după montarea pompei: motorul pornește greu sau deloc, pierde motorină pe la racorduri ori erorile de presiune revin în câteva zile."
  },
  {
   "i": 3,
   "start": 26.43,
   "end": 36.482,
   "text": "Prima greșeală e pompa pornită goală. Producătorii scriu că pompa nu are voie să meargă fără motorină: instalația se umple și se aerisește înainte de prima pornire."
  },
  {
   "i": 4,
   "start": 36.902,
   "end": 45.952,
   "text": "A doua e murdăria. Ajunge o pompă lăsată cu racordurile deschise pe un banc prăfuit: particule mai mici de o zecime de milimetru pot da defecte."
  },
  {
   "i": 5,
   "start": 46.372,
   "end": 56.357,
   "text": "A treia sunt conductele de înaltă presiune refolosite. Capătul lor s-a deformat la prima strângere și etanșează mai greu, iar din filet se pot desprinde așchii fine."
  },
  {
   "i": 6,
   "start": 56.777,
   "end": 63.168,
   "text": "A patra ține de calculator: după o pompă sau un regulator nou, multe mașini cer adaptare cu testerul."
  },
  {
   "i": 7,
   "start": 63.668,
   "end": 70.918,
   "text": "Cum eviți: pompa se montează curat, cu dopuri pe racorduri până în ultima clipă și după procedura de umplere a mașinii."
  },
  {
   "i": 8,
   "start": 71.518,
   "end": 81.223,
   "text": "Ce facem noi la Turbo Doctor: fiecare pompă recondiționată pleacă de la noi testată pe banc, cu fișa de test, cu piesele înlocuite și cu garanție de douăsprezece luni."
  },
  {
   "i": 9,
   "start": 81.643,
   "end": 89.45,
   "text": "Iar dacă o pompă montată în altă parte nu face presiune, o verificăm pe banc și afli dacă problema e la pompă sau în altă parte."
  },
  {
   "i": 10,
   "start": 90.25,
   "end": 93.44,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 11,
   "start": 93.84,
   "end": 98.985,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 12,
   "start": 99.385,
   "end": 103.11,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
