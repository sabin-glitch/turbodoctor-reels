{
 "end": 107.16666666666667,
 "lines": [
  {
   "i": 0,
   "start": 3.0,
   "end": 11.075,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 6 din 17: apa din motorină."
  },
  {
   "i": 1,
   "start": 11.425,
   "end": 15.205,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 15.805,
   "end": 25.35,
   "text": "Semnele: martorul de apă în motorină, acolo unde există, pornire grea și mers neregulat, mai ales după o alimentare sau după ce mașina a stat mult."
  },
  {
   "i": 3,
   "start": 25.77,
   "end": 34.435,
   "text": "Apa ajunge în rezervor odată cu motorina, din rezervoarele benzinăriei, sau se adună din condens. E mai grea decât motorina și se așază la fund."
  },
  {
   "i": 4,
   "start": 34.855,
   "end": 43.495,
   "text": "Filtrul de motorină are un separator care o oprește. Dacă separatorul nu e golit sau filtrul e depășit, apa trece mai departe, spre pompă."
  },
  {
   "i": 5,
   "start": 43.915,
   "end": 50.885,
   "text": "Apa nu unge. Unde ajunge ea în locul motorinei, pelicula dintre piese se rupe, iar uzura se accelerează."
  },
  {
   "i": 6,
   "start": 51.305,
   "end": 59.405,
   "text": "Apoi vine rugina. Apa se combină cu acizii din motorină și atacă metalul: carcasa pompei, arborele, supapele."
  },
  {
   "i": 7,
   "start": 59.825,
   "end": 66.625,
   "text": "Rugina desprinsă devine la rândul ei praf abraziv, care merge mai departe spre regulator și spre injectoare."
  },
  {
   "i": 8,
   "start": 67.125,
   "end": 74.7,
   "text": "Cum eviți: schimbă filtrul la timp, golește separatorul de apă când cere mașina și alimentează de la benzinării cunoscute."
  },
  {
   "i": 9,
   "start": 75.3,
   "end": 85.09,
   "text": "Ce facem noi la Turbo Doctor: desfacem pompa și căutăm urmele de rugină la microscop. Curățăm piesele cu ultrasunete și le înlocuim pe cele corodate cu piese noi."
  },
  {
   "i": 10,
   "start": 85.51,
   "end": 92.51,
   "text": "Testăm pompa pe banc, inclusiv la etanșeitate. Iar dacă apa a ajuns și la injectoare, le verificăm și pe ele."
  },
  {
   "i": 11,
   "start": 93.31,
   "end": 96.5,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 96.9,
   "end": 102.045,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 102.445,
   "end": 106.17,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ],
