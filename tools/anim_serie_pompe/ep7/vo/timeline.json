 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 3.0,
   "end": 12.105,
   "text": "Seria „De ce se strică pompele de înaltă presiune”. Astăzi prezentăm cauza 7 din 17: AdBlue pus în rezervorul de motorină."
  },
  {
   "i": 1,
   "start": 12.455,
   "end": 16.235,
   "text": "Vezi toate cauzele pe TikTok, Facebook și YouTube-ul nostru."
  },
  {
   "i": 2,
   "start": 16.835,
   "end": 24.258,
   "text": "Semnele, dacă motorul a fost pornit: mers neregulat, opriri și, până la urmă, un motor care nu mai pornește."
  },
  {
   "i": 3,
   "start": 24.678,
   "end": 33.319,
   "text": "AdBlue este uree dizolvată în apă. Locul lui e în rezervorul separat, cu bușon albastru, de unde ajunge în evacuare, nu în motor."
  },
  {
   "i": 4,
   "start": 33.739,
   "end": 42.04,
   "text": "Turnat din greșeală în motorină, nu se amestecă cu ea. E mai greu și coboară la fundul rezervorului, exact de unde trage pompa electrică."
  },
  {
   "i": 5,
   "start": 42.46,
   "end": 50.11,
   "text": "Odată pus contactul, pompa electrică îl trimite spre filtru și spre pompa de înaltă presiune, unde ar trebui să ajungă doar motorină."
  },
  {
   "i": 6,
   "start": 50.53,
   "end": 61.735,
   "text": "AdBlue este coroziv pentru oțel și aluminiu, iar când se usucă lasă cristale albe, ca sarea. Depunerile rămân pe piesele instalației, iar pompa și injectoarele au de suferit."
  },
  {
   "i": 7,
   "start": 62.155,
   "end": 68.645,
   "text": "Dacă motorul a mers, producătorii cer de obicei înlocuirea instalației, de la rezervor până la injectoare."
  },
  {
   "i": 8,
   "start": 69.145,
   "end": 77.385,
   "text": "Cum eviți paguba: dacă ai greșit rezervorul, nu pune contactul. Mașina se tractează, iar rezervorul se golește și se curăță."
  },
  {
   "i": 9,
   "start": 77.985,
   "end": 84.96,
   "text": "Ce facem noi la Turbo Doctor: desfacem pompa și injectoarele și vedem, la microscop, cât a înaintat coroziunea."
  },
  {
   "i": 10,
   "start": 85.38,
   "end": 94.975,
   "text": "Îți spunem ce se mai poate recondiționa și ce trebuie înlocuit, iar hotărârea o luăm împreună. Ce se poate salva curățăm cu ultrasunete și testăm pe banc."
  },
  {
   "i": 11,
   "start": 95.775,
   "end": 98.965,
   "text": "La Turbo Doctor suntem experți în aceste probleme."
  },
  {
   "i": 12,
   "start": 99.365,
   "end": 104.51,
   "text": "Acum că știi cum poți evita această problemă, ar trebui să ajungi cât mai târziu la noi."
  },
  {
   "i": 13,
   "start": 104.91,
   "end": 108.635,
   "text": "Iar dacă ai nevoie de noi, la noi diagnoza este gratuită."
  }
 ]
