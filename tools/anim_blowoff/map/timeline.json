 "cold_words": [],
 "narrator": true,
 "sentences": [
  {
   "i": 0,
   "start": 0.3,
   "end": 3.0,
   "text": "Dacă ai diesel și auzi sunetul ăsta..."
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 9.85,
   "text": "Ca un suflat de blow-off, nu e tuning. E semnul că turbina se va distruge."
  },
  {
   "i": 2,
   "start": 10.55,
   "end": 13.85,
   "text": "Hai să-ți explic de unde vine, de fapt, sunetul ăsta."
  },
  {
   "i": 3,
   "start": 14.35,
   "end": 24.51,
   "text": "Pe un motor turbo pe benzină, sunetul este normal. Când ridici piciorul de pe accelerație, clapeta se închide, iar supapa blow-off eliberează aerul rămas sub presiune."
  },
  {
   "i": 4,
   "start": 25.11,
   "end": 34.57,
   "text": "Pe diesel e altfel. Clapeta rămâne deschisă, iar aerul trece mai departe prin motor. De aceea, din fabrică, un diesel nici nu are supapă blow-off."
  },
  {
   "i": 5,
   "start": 35.07,
   "end": 40.73,
   "text": "Atunci de unde vine sunetul? Din turbină. Mai exact, de la geometria variabilă."
  },
  {
   "i": 6,
   "start": 41.18,
   "end": 46.605,
   "text": "Geometria variabilă este un inel de palete din carcasa turbinei, mișcate de un actuator."
  },
  {
   "i": 7,
   "start": 47.055,
   "end": 55.895,
   "text": "La turații mici, paletele se închid, ca gazele să lovească roata cu viteză mare. La turații mari se deschid, ca turbina să nu se supratureze."
  },
  {
   "i": 8,
   "start": 56.345,
   "end": 62.965,
   "text": "În timp, calamina se depune pe palete și le blochează pe poziția închis. Actuatorul nu le mai poate deschide."
  },
  {
   "i": 9,
   "start": 63.415,
   "end": 73.44,
   "text": "Gazele lovesc roata turbinei cu viteză prea mare, tot timpul. Turbina trece de turația ei maximă, iar presiunea urcă peste limită. Asta este supraturarea."
  },
  {
   "i": 10,
   "start": 74.04,
   "end": 81.86,
   "text": "Acum ridici piciorul de pe accelerație. Motorul nu mai înghite tot aerul, dar compresorul, supraturat, împinge în continuare."
  },
  {
   "i": 11,
   "start": 82.31,
   "end": 90.84,
   "text": "Aerul iese foarte greu și se întoarce prin roata compresorului, în pulsuri. Acesta este pompajul. Și sună exact ca un blow-off."
  },
  {
   "i": 12,
   "start": 91.34,
   "end": 97.66,
   "text": "Fiecare puls pune tensiune pe paletele roții compresor și împinge axul în lagărul axial."
  },
  {
   "i": 13,
   "start": 98.11,
   "end": 105.075,
   "text": "Lagărul se uzează, axul capătă joc, iar paletele ajung să atingă carcasa. Așa se distruge turbina."
  },
  {
   "i": 14,
   "start": 105.775,
   "end": 114.36,
   "text": "Același sunet, două situații complet diferite. Pe benzină, o supapă care își face treaba. Pe diesel, o turbină care intră în pompaj."
  },
  {
   "i": 15,
   "start": 114.96,
   "end": 123.755,
   "text": "Deci, dacă dieselul tău suflă așa când ridici piciorul, nu e tuning. Verifică geometria variabilă, cât turbina încă se mai poate repara."
  }
 ]
}