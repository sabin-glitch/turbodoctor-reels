ributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"155940759":{"pageid":155940759,"ns":6,"title":"File:BMW N63B44B F05-01.jpg","imagerepository":"local","imageinfo":[{"size":4055265,"width":4624,"height":3468,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/BMW_N63B44B_F05-01.jpg/1920px-BMW_N63B44B_F05-01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1200,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/BMW_N63B44B_F05-01.jpg/3840px-BMW_N63B44B_F05-01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/BMW_N63B44B_F05-01.jpg/1920px-BMW_N63B44B_F05-01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1200,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/BMW_N63B44B_F05-01.jpg/3840px-BMW_N63B44B_F05-01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/9/9f/BMW_N63B44B_F05-01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:BMW_N63B44B_F05-01.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=155940759","extmetadata":{"ImageDescription":{"value":"BMW F06 650i\u306b\u642d\u8f09\u3055\u308c\u305fN63B44B","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:%E3%83%A1%E3%83%AB%E3%83%93%E3%83%AB\" title=\"User:\u30e1\u30eb\u30d3\u30eb\">\u30e1\u30eb\u30d3\u30eb</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"155940758":{"pageid":155940758,"ns":6,"title":"File:BMW N63B44B F05-02.jpg","imagerepository":"local","imageinfo":[{"size":3898789,"width":4624,"height":3468,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/BMW_N63B44B_F05-02.jpg/1920px-BMW_N63B44B_F05-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1200,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/BMW_N63B44B_F05-02.jpg/3840px-BMW_N63B44B_F05-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/BMW_N63B44B_F05-02.jpg/1920px-BMW_N63B44B_F05-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1200,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/BMW_N63B44B_F05-02.jpg/3840px-BMW_N63B44B_F05-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e8/BMW_N63B44B_F05-02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:BMW_N63B44B_F05-02.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=155940758","extmetadata":{"ImageDescription":{"value":"BMW F06 650i\u306b\u642d\u8f09\u3055\u308c\u305fN63B44B","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:%E3%83%A1%E3%83%AB%E3%83%93%E3%83%AB\" title=\"User:\u30e1\u30eb\u30d3\u30eb\">\u30e1\u30eb\u30d3\u30eb</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"2971686":{"pageid":2971686,"ns":6,"title":"File:BMW xDrive.jpg","imagerepository":"local","imageinfo":[{"size":791402,"width":1536,"height":2048,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/4/46/BMW_xDrive.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":2133,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/4/46/BMW_xDrive.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":2133},"url":"https://upload.wikimedia.org/wikipedia/commons/4/46/BMW_xDrive.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:BMW_xDrive.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=2971686","extmetadata":{"ImageDescription":{"value":"<p>BMW xDrive is BMW's four-wheel drive system that powers the X3, X5 and 2006 and later xd and xi 3 Series and 5 Series models.\n</p><p>Instead of a 60-40 (rear-front) power split (which all millennium four-wheel drive BMW's exhibit\u00a0? 325xi, 330xi, early X5) with power being cut to wheels which lost traction through DSC (Dynamic Stability Control), xDrive allows power to be split between the front and rear axles through use of a multiplate clutch located between the gearbox and the Cardian shaft. This setup allows xDrive vehicles to split power in virtually any way it pleases. If the car felt like it was in a threatening situation (note not an unstable one), xDrive would react immediately, often before the driver ever knew of its intervention, to alleviate traction and control of the vehicle.\n</p><p>xDrive is also closely knit with DSC. In the case that wheelspin still occurs while xDrive is or has been shifting power, DSC can brake independent wheels to regain traction. xDrive also helps in cornering. When the vehicle senses that it was about to understeer or oversteer the vehicle can independently cut traction to either of the front wheels or rear wheels to help regain stability and keep the driver on the road.\n</p>\nxDrive was one of the first technologies[citation needed]used to intervene before the driver was aware that the car was becoming or would become unstable. Its intervention is transparent to the driver.","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/88758808@N00/527932647/\">BMW xDrive</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/88758808@N00\">Ahmad Ziyad Maricar</a> from Bangsar, Malaysia","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]}}}}